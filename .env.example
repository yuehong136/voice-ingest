# Copy to .env. These sample values are not production secrets.
VOICE_API_KEY=replace-with-a-long-random-api-key
VOICE_DB_PASSWORD=replace-with-a-random-db-password
VOICE_DATABASE_URL=postgresql+asyncpg://voice:replace-with-a-random-db-password@localhost:55432/voice
VOICE_S3_ACCESS_KEY=voice-admin
VOICE_S3_SECRET_KEY=replace-with-a-long-random-storage-secret
VOICE_S3_BUCKET=voice-ingest
VOICE_S3_REGION=us-east-1
# Community-maintained MinIO fork; latest stable release verified 2026-09-08.
# AGPL-3.0-or-later; no AIStor activation file required. Pin releases, not latest.
VOICE_MINIO_IMAGE=pgsty/silo:RELEASE.2026-09-03T13-18-01Z
VOICE_S3_ENDPOINT=http://localhost:19000
# Must be reachable by CLI users AND Aliyun for real ASR.
VOICE_S3_PUBLIC_ENDPOINT=http://localhost:19000
VOICE_BIND_ADDRESS=127.0.0.1
# Optional independent Compose ports and the exact browser origin allowed by MinIO.
VOICE_API_PORT=18080
VOICE_WEB_PORT=18081
VOICE_S3_PORT=19000
VOICE_WEB_ORIGIN=http://127.0.0.1:18081
# To use another runtime file, set VOICE_ENV_FILE to its absolute path as well as --env-file.
VOICE_PROVIDER=mock
VOICE_ALIYUN_REGION=beijing
VOICE_ALIYUN_WORKSPACE_ID=
VOICE_ALIYUN_API_KEY=
# signed_url for production; temporary_upload enables local real-ASR evaluation.
VOICE_ALIYUN_SOURCE_MODE=signed_url
VOICE_MAX_INFLIGHT=2
VOICE_ENABLE_MCP=true
# Optional build mirrors. Defaults preserve the official upstream registries.
VOICE_APT_MIRROR=deb.debian.org
VOICE_PYPI_INDEX_URL=https://pypi.org/simple
# Leave empty for HTTPS indexes. Set only for a trusted internal HTTP mirror.
VOICE_PYPI_TRUSTED_HOST=
VOICE_NPM_REGISTRY=https://registry.npmjs.org
